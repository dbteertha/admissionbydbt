{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/events",
      "destination": "/api/index.js"
    },
    {
      "source": "/health",
      "destination": "/api/index.js"
    },
    {
      "source": "/tracker",
      "destination": "/api/tracker.js"
    },
    {
      "source": "/api/google-login",
      "destination": "/api/google-login.js"
    },
    {
      "source": "/api/google-callback",
      "destination": "/api/google-callback.js"
    },
    {
      "source": "/api/google-token",
      "destination": "/api/google-token.js"
    },
    {
      "source": "/api/google-logout",
      "destination": "/api/google-logout.js"
    },
    {
      "source": "/privacy",
      "destination": "/api/privacy.js"
    },
    {
      "source": "/terms",
      "destination": "/api/terms.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
